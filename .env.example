# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Moore Made transactional email
RESEND_API_KEY=re_REPLACE_ME
MOORE_MADE_FROM_EMAIL=Moore Made <orders@updates.mooremade.store>
MOORE_MADE_ADMIN_EMAIL=your-email@example.com

# Local development. Change to https://mooremade.store after deployment.
SITE_URL=http://localhost:3000

# Phase 3 no longer uses a shared ADMIN_PASSWORD or ADMIN_SESSION_SECRET.
# Admin access is controlled by Supabase Auth + user_roles + required TOTP MFA.

# Stripe payments (Phase 4)
# Use sk_test_... while testing locally, then switch to live keys at launch.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Local webhook secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or the signing secret from the production Stripe Dashboard webhook.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Temporary/manual payment option. Paste the exact Cash App payment/profile URL
# you want customers to open after approving their proof + quote.
CASHAPP_PAYMENT_URL=

# Optional: notify multiple Moore Made staff inboxes about new customer messages.
# Comma-separated. If omitted, message alerts use MOORE_MADE_ADMIN_EMAIL above.
MOORE_MADE_ADMIN_EMAILS=
